{
  "name": "thousand-nights",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "deploy": "cf deploy",
    "db:local": "wrangler d1 migrations apply thousand-nights --local --persist-to .cloudflare/state",
    "db:remote": "cf d1 migrations apply 0af53f06-75b8-40e5-9b9b-a516bdf574d0 --dir migrations",
    "import:sql": "node scripts/catalog-to-sql.mjs",
    "import:local": "wrangler d1 execute thousand-nights --local --persist-to .cloudflare/state --file data/catalog.sql --json > /dev/null",
    "import:remote": "wrangler d1 execute thousand-nights --remote --file data/catalog.sql",
    "typecheck": "cf workers types && tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-virtual": "^3.14.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "motion": "^13.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.sha-52b0dc0e9",
    "@cloudflare/workers-types": "^5.20261003.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "cf": "^1.0.0-beta.12",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "wrangler": "^4.147.0"
  },
  "packageManager": "pnpm@12.0.0-rc.8"
}
