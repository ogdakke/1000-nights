{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["@cloudflare/workers-types", "vite/client", "node"]
  },
  "include": [
    "src",
    "worker",
    "vite.config.ts",
    "cloudflare.config.ts",
    ".cloudflare/types/index.d.ts"
  ]
}
